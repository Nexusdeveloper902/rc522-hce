{
  "name": "RC522-HCE",
  "version": "1.2.0",
  "description": "RC522 NFC reader with Android-HCE phone-as-credential identification: ISO-DEP SELECT AID + challenge-response (HMAC-SHA256), enrollment key-wrap, debounce and mock reader. Host-testable pure C++ core + ESP32 Arduino driver.",
