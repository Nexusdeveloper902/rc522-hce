  "repository": {
    "type": "git",
    "url": "https://github.com/NexusDeveloper902/rc522-hce.git"
  },
  "authors": [
    {
      "name": "NexusDeveloper902",
      "email": "jeroperez2011@gmail.com"
    }
  ],
  "license": "Apache-2.0",
  "frameworks": ["arduino"],
  "platforms": "*",
  "headers": ["HceReader.h", "HceProtocol.h", "NfcReader.h", "Rc522HceReader.h", "Rc522HceConfig.h", "TsLog.h", "CompatNames.h", "CardDebouncer.h", "MockNfcReader.h"],
  "dependencies": {
    "miguelbalboa/MFRC522": "^1.4.11"
  }
}
